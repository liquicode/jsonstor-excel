{
    "name": "@liquicode/jsonstor-excel",
    "version": "0.1.0",
    "description": "A jsonstor adapter which stores documents in an Excel worksheet or CSV file.",
    "license": "MIT",
    "engines": {
        "node": ">=10.4.0"
    },
    "homepage": "http://jsonstor.liquicode.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/liquicode/jsonstor-excel"
    },
    "authors": [
        {
            "name": "Andre' G. Bowlin",
            "email": "agbowlin@gmail.com",
            "homepage": "http://liquicode.com"
        }
    ],
    "main": "src/jsonstor-excel.js",
    "types": "./types/jsonstor-excel.d.ts",
    "exports": {
        ".": {
            "types": "./types/jsonstor-excel.d.ts",
            "import": "./src/jsonstor-excel.mjs",
            "require": "./src/jsonstor-excel.js",
            "default": "./src/jsonstor-excel.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "types",
        "license.md",
        "readme.md",
        "history.md"
    ],
    "scripts": {
        "publish version": "npx @liquicode/devops --tasks .\\build\\devops.tasks.js publish_version",
        "start new version": "npx @liquicode/devops --tasks .\\build\\devops.tasks.js start_new_version"
    },
    "keywords": [
        "jsonstor",
        "excel",
        "worksheet",
        "mongo query"
    ],
    "devDependencies": {
        "@liquicode/devops": "^0.1.0",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
        "webpack-node-externals": "^3.0.0"
    },
    "dependencies": {
        "@liquicode/jsongin": "^0.1.0",
        "@liquicode/jsonstor": "^0.1.0",
        "xlsx": "^0.18.5"
    }
}